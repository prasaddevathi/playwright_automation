ENV=dev
BASE_URL=https://dev.example-app.internal
API_URL=https://dev.example-app.internal/api
USERNAME=automation.user@example.com
PASSWORD=changeme

# --- Logging (utils/logger.ts) ---
# Level written to reports/logs/execution.log and each test's report attachment
LOG_LEVEL=debug
# Level echoed to the terminal (keep at warn for readable parallel runs)
LOG_CONSOLE_LEVEL=warn

